# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=enrollment_db

# InsightFace Model Paths
SCRFD_MODEL_PATH=/home/pavithranraj/.insightface/models/buffalo_l
ARCFACE_MODEL_PATH=/home/pavithranraj/.insightface/models/buffalo_l
INSIGHTFACE_MODEL_PACK=buffalo_l

# FAISS Vector Search Configuration
# Options: IndexFlatIP, IndexIVFFlat, HNSW
FAISS_INDEX_TYPE=IndexFlatIP
FAISS_INDEX_PATH=faiss_index.bin
SIMILARITY_THRESHOLD=0.65
TOP_K_DEFAULT=5

# Server Configuration
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=60
MAX_IMAGE_SIZE_MB=10
